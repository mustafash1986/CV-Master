{
  "manifest_version": 3,
  "name": "CV Servant – Smart Job Auto-Fill & Tracker",
  "version": "1.0.1",
  "description": "تعبئة نماذج التقديم على الوظائف تلقائياً وتتبع الطلبات المكتملة في برنامج CV Servant للمهندس مصطفى شوقي",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CV Servant Job Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:5822/*",
    "http://localhost:5822/*",
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["common/candidate_profile.js", "content/autofill.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
